<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Ad-hoc build entitlements (no Developer ID / provisioning profile).

        Security review notes (2026-06-10):
        - com.apple.security.cs.disable-library-validation is required because
          the embedded KeyboardShortcuts.framework is re-signed ad-hoc (Team ID
          = none) while Hardened Runtime enforces Team-ID-matched libraries on
          macOS 14+. Remove this once the app ships with a real Developer ID.
        - network.client is used EXCLUSIVELY for https://api.openai.com
          (transcription, chat, key validation). There is no other endpoint.
        - No app sandbox in the ad-hoc beta: the accessibility temporary
          exception and CGEvent posting require it disabled. Revisit for a
          notarized release.

        Do NOT use these entitlements for App Store or notarized builds —
        use VoiceflowDesktop.entitlements with a real Developer ID instead.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access: api.openai.com only -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Microphone recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>

    <!-- Accessibility API (text insertion into active field) -->
    <key>com.apple.security.temporary-exception.accessibility</key>
    <true/>
</dict>
</plist>
