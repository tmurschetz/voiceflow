<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- App icon: matches Resources/AppIcon.icns (built by scripts/make-icon.sh) -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <!-- Hide from Dock, run as menu bar utility -->
    <key>LSUIElement</key>
    <true/>

    <!-- Microphone access -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Voiceflow needs microphone access to record your speech for transcription.</string>

    <!-- Accessibility access (for inserting text into active field) -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Voiceflow needs Accessibility access to insert transcribed text directly into your active text field.</string>

    <!-- Human-readable app name -->
    <key>CFBundleDisplayName</key>
    <string>Voiceflow</string>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- ============================================================ -->
    <!-- Sparkle auto-updater (https://sparkle-project.org)         -->
    <!-- ============================================================ -->

    <!-- URL of your appcast.xml — replace before shipping updates  -->
    <key>SUFeedURL</key>
    <string>https://updates.voiceflow.app/appcast.xml</string>

    <!-- EdDSA public key generated by Sparkle's generate_keys tool -->
    <!-- Run: .build/artifacts/sparkle/.../bin/generate_keys        -->
    <!-- Replace BOTH placeholders before enabling auto-updates      -->
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_EDDSA_PUBLIC_KEY</string>

    <!-- Show "Check for Updates" in the app menu automatically     -->
    <key>SUEnableAutomaticChecks</key>
    <true/>

    <!-- Supported URL scheme for magic link auth (if used) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.voiceflow.desktop</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>voiceflow</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
