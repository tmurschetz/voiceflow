# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode build artefacts
voiceflow-desktop/.build/
voiceflow-desktop/build/
voiceflow-desktop/*.xcarchive
voiceflow-desktop/*.dmg
voiceflow-desktop/VoiceflowDesktop.xcodeproj/xcuserdata/
